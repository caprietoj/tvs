# ============================================
# CONFIGURACIÓN DE AMBIENTE
# ============================================
# DESARROLLO: local, testing
# PRODUCCIÓN: production
APP_NAME="Intranet The Victoria School"
APP_ENV=local
APP_KEY=base64:IMxWLdZAX9IL9USyHlB7pCT8zF7bq/ixrNtPlthjUoM=
APP_DEBUG=true
APP_TIMEZONE=America/Bogota
APP_URL=http://intranet.tvs.edu.co

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# ============================================
# CONFIGURACIÓN DE LOGS
# ============================================
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ============================================
# CONFIGURACIÓN DE BASE DE DATOS
# ============================================
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=caprietoj-intranet
DB_USERNAME=root
DB_PASSWORD=

# ============================================
# CONFIGURACIÓN DE SESIONES Y CACHE
# ============================================
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database
CACHE_PREFIX=

# ============================================
# CONFIGURACIÓN DE REDIS
# ============================================
MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ============================================
# CONFIGURACIÓN DE CORREO ELECTRÓNICO
# ============================================
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=""
MAIL_PASSWORD=""
MAIL_FROM_ADDRESS=""
MAIL_FROM_NAME="${APP_NAME}"

# ============================================
# CONFIGURACIÓN DE USUARIOS DEL SISTEMA
# ============================================
ADMIN_NAME=""
ADMIN_EMAIL=""                                      
ADMIN_PASSWORD=""

# ============================================
# CONFIGURACIÓN DE AWS
# ============================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ============================================
# CONFIGURACIÓN DE VITE
# ============================================
VITE_APP_NAME="${APP_NAME}"

# ============================================
# CONFIGURACIÓN DE CORREOS POR AMBIENTE
# ============================================
# IMPORTANTE: Estas configuraciones determinan qué correos se usan
# 
# DESARROLLO/TESTING (APP_ENV=local o testing):
# - SECTION_EMAILS_CONFIG=section-mail-test  → Usa correos @test.com
# - EMAIL_TEST_MODE=true                     → Activa interceptación adicional
# - PURCHASE_REQUEST_TEST_MODE=true          → Solicitudes de compra en modo prueba
#
# PRODUCCIÓN (APP_ENV=production):
# - SECTION_EMAILS_CONFIG=section_emails     → Usa correos @tvs.edu.co  
# - EMAIL_TEST_MODE=false                    → Desactiva interceptación
# - PURCHASE_REQUEST_TEST_MODE=false         → Solicitudes de compra normales

# Configuración actual para DESARROLLO:
SECTION_EMAILS_CONFIG=section-mail-test
EMAIL_TEST_MODE=true
PURCHASE_REQUEST_TEST_MODE=true
PURCHASE_REQUEST_DISABLE_EMAILS=false

# Correos de prueba específicos (solo para desarrollo):
EMAIL_TEST_SISTEMAS=mi-test-sistemas@tvs.edu.co
EMAIL_TEST_PAI=test-pai-personalizado@tvs.edu.co

# ============================================
# CONFIGURACIÓN DE AMBIENTE
# ============================================

### 📧 **Comportamiento Final:**

# **DESARROLLO (`APP_ENV=local`):**
# - ✅ Usa section-mail-test.php 
# - ✅ Correos: `@test.com`
# - ✅ Protegido contra envíos accidentales

# **PRODUCCIÓN (`APP_ENV=production`):**
# - ✅ Usa section_emails.php automáticamente
# - ✅ Correos: `@tvs.edu.co`
# - ✅ Ignora cualquier configuración de prueba

# ### 🚀 **Para Implementar en Producción:**

# 1. **Copiar las configuraciones del archivo .env.production.example**
# 2. **Asegurar que `APP_ENV=production`**
# 3. **Ejecutar `php artisan config:cache`**
# 4. **Verificar que funciona correctamente**
