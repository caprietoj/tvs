<?php

namespace App\Services;

use App\Models\PurchaseOrder;
use Barryvdh\DomPDF\Facade\Pdf;
use Illuminate\Support\Facades\Log;
use Illuminate\Support\Facades\Storage;
use Exception;

class PurchaseOrderPdfService
{
    public function __construct()
    {
        // Constructor simplificado
    }
    
    /**
     * Filtra las selecciones mixtas para un proveedor específico
     */
    private function filterSelectionsForProvider(PurchaseOrder $order, $allSelections)
    {
        if (!$order->provider) {
            Log::warning('Orden sin proveedor asignado', ['order_id' => $order->id]);
            return collect();
        }
        
        $filtered = $allSelections->filter(function($selection) use ($order) {
            return $selection->quotation && 
                   $selection->quotation->provider_name === $order->provider->nombre;
        });
        
        Log::info('Filtrado de selecciones por proveedor completado', [
            'order_id' => $order->id,
            'provider_name' => $order->provider->nombre,
            'all_selections_count' => $allSelections->count(),
            'filtered_selections_count' => $filtered->count(),
            'filtered_items' => $filtered->map(function($sel) {
                return [
                    'item' => $sel->item_description,
                    'provider' => $sel->quotation->provider_name ?? 'N/A'
                ];
            })->toArray()
        ]);
        
        return $filtered;
    }

    /**
     * Prepara los valores fiscales consistentes para el PDF
     * 
     * @param PurchaseOrder $order Orden de compra
     * @param array $customData Datos personalizados del PDF (opcional)
     * @return array Arreglo con valores fiscales normalizados
     */
    private function prepareTaxValues(PurchaseOrder $order, $customData = null)
    {
        // Si hay datos personalizados, usarlos como fuente principal
        if (!empty($customData)) {
            $subtotal = isset($customData['subtotal']) ? floatval($customData['subtotal']) : floatval($order->subtotal);
            $ivaAmount = isset($customData['iva_amount']) ? floatval($customData['iva_amount']) : floatval($order->iva_amount);
            $totalAmount = isset($customData['total']) ? floatval($customData['total']) : floatval($order->total_amount);
            
            // Verificación de consistencia
            $calculatedTotal = $subtotal + $ivaAmount;
            
            // Si el total no coincide con subtotal + IVA, ajustar para mantener consistencia
            if (abs($calculatedTotal - $totalAmount) > 0.01) {
                Log::warning('Inconsistencia detectada en valores fiscales personalizados', [
                    'order_id' => $order->id,
                    'subtotal' => $subtotal,
                    'iva_amount' => $ivaAmount,
                    'provided_total' => $totalAmount,
                    'calculated_total' => $calculatedTotal,
                    'difference' => $calculatedTotal - $totalAmount
                ]);
                
                // Usar el cálculo correcto
                $totalAmount = $calculatedTotal;
            }
            
            $includesIva = $ivaAmount > 0;
        } else {
            // Usar valores originales de la orden
            $subtotal = floatval($order->subtotal);
            $ivaAmount = floatval($order->iva_amount);
            $totalAmount = floatval($order->total_amount);
            
            // Verificación de consistencia
            $calculatedTotal = $subtotal + $ivaAmount;
            
            // Si el total no coincide con subtotal + IVA, ajustar para mantener consistencia
            if (abs($calculatedTotal - $totalAmount) > 0.01) {
                Log::warning('Inconsistencia detectada en valores fiscales de la orden', [
                    'order_id' => $order->id,
                    'subtotal' => $subtotal,
                    'iva_amount' => $ivaAmount,
                    'db_total' => $totalAmount,
                    'calculated_total' => $calculatedTotal,
                    'difference' => $calculatedTotal - $totalAmount
                ]);
                
                // Usar el cálculo correcto
                $totalAmount = $calculatedTotal;
            }
            
            $includesIva = $order->includes_iva;
        }
        
        // Procesar impuestos aplicados desde additional_items si existen
        $appliedTaxes = isset($order->additional_items['applied_taxes_detail']) 
            ? $order->additional_items['applied_taxes_detail'] 
            : [];
        
        $iva19Amount = 0;
        $iva5Amount = 0;
        $ipoconsumo8Amount = 0;
        $ipoconsumo4Amount = 0;
        $hasDetailedTaxes = false;
        
        // Si hay impuestos detallados, usarlos
        if (!empty($appliedTaxes)) {
            foreach ($appliedTaxes as $tax) {
                $hasDetailedTaxes = true;
                switch ($tax['type']) {
                    case 'IVA':
                        if ($tax['rate'] == 19) {
                            $iva19Amount = $tax['amount'];
                        } elseif ($tax['rate'] == 5) {
                            $iva5Amount = $tax['amount'];
                        }
                        break;
                    case 'IMPUESTO_CONSUMO':
                        if ($tax['rate'] == 8) {
                            $ipoconsumo8Amount = $tax['amount'];
                        } elseif ($tax['rate'] == 4) {
                            $ipoconsumo4Amount = $tax['amount'];
                        }
                        break;
                }
            }
        }
        
        // Si no hay impuestos detallados pero hay IVA, asignarlo como IVA 19%
        if (!$hasDetailedTaxes && $includesIva && $ivaAmount > 0) {
            $iva19Amount = $ivaAmount;
        }
        
        return [
            'subtotal' => $subtotal,
            'ivaAmount' => $ivaAmount,
            'iva_amount' => $ivaAmount, // Duplicado para compatibilidad con plantillas
            'totalAmount' => $totalAmount,
            'total_amount' => $totalAmount, // Duplicado para compatibilidad con plantillas
            'includesIva' => $includesIva,
            'iva19Amount' => $iva19Amount,
            'iva5Amount' => $iva5Amount,
            'ipoconsumo8Amount' => $ipoconsumo8Amount,
            'ipoconsumo4Amount' => $ipoconsumo4Amount,
            'hasDetailedTaxes' => $hasDetailedTaxes,
        ];
    }

    /**
     * Genera el PDF de una orden de compra
     */
    public function generatePdf(PurchaseOrder $order, $providerSelections = null)
    {
        try {
            // Cargar la solicitud y sus relaciones
            $order->load(['purchaseRequest.user', 'purchaseRequest.selectedQuotation', 'purchaseRequest.approver', 'provider']);
            
            // Verificar si hay datos personalizados del PDF
            $hasCustomData = !empty($order->pdf_custom_data);
            
            if ($hasCustomData) {
                // Usar datos personalizados para generar el PDF
                return $this->generateCustomPdf($order, $providerSelections);
            }
            
            // Preparar valores fiscales consistentes
            $taxValues = $this->prepareTaxValues($order);
            
            // Verificar si es un servicio sin cotización
            if ($order->purchaseRequest->isNoQuotationService()) {
                // Usar plantilla para servicios sin cotización
                $view = view('purchase-orders.pdf-template-service', array_merge([
                    'order' => $order,
                    'purchaseRequest' => $order->purchaseRequest,
                ], $taxValues));
            } else {
                // Verificar si tenemos selecciones específicas del proveedor (selección mixta)
                if ($providerSelections !== null) {
                    // Usar selecciones específicas del proveedor para selección mixta
                    $view = view('purchase-orders.pdf-template-mixed', array_merge([
                        'order' => $order,
                        'purchaseRequest' => $order->purchaseRequest,
                        'mixedSelections' => $providerSelections,
                    ], $taxValues));
                } else {
                    // Verificar si es una orden con selección mixta (caso legacy)
                    $hasMixedSelection = $order->purchaseRequest->quotationItemSelections()->exists();
                    
                    if ($hasMixedSelection) {
                        // Cargar selecciones específicas del proveedor
                        $mixedSelections = $this->getProviderSpecificSelections($order);
                        
                        // Usar plantilla para selección mixta
                        $view = view('purchase-orders.pdf-template-mixed', array_merge([
                            'order' => $order,
                            'purchaseRequest' => $order->purchaseRequest,
                            'mixedSelections' => $mixedSelections,
                        ], $taxValues));
                    } else {
                        // Obtener datos de la cotización seleccionada para orden tradicional
                        $quotation = $order->purchaseRequest->selectedQuotation;
                        
                        // Usar plantilla tradicional
                        $view = view('purchase-orders.pdf-template-new', array_merge([
                            'order' => $order,
                            'purchaseRequest' => $order->purchaseRequest,
                            'quotation' => $quotation,
                            'items' => $order->purchaseRequest->purchase_items ?? [],
                            'additionalItems' => $order->additional_items ?? [],
                            'tax_consumption' => 0, // Si no se usa impuesto al consumo
                            'discount' => 0, // Si no se manejan descuentos
                        ], $taxValues));
                    }
                }
            }
            
            // Generar PDF
            $pdf = \PDF::loadHTML($view->render());
            $pdf->setPaper('letter', 'portrait');
            
            // Si ya existe un PDF, eliminarlo
            if ($order->file_path && $order->file_path !== 'pending_generation' && Storage::disk('public')->exists($order->file_path)) {
                Storage::disk('public')->delete($order->file_path);
                Log::info('PDF anterior eliminado para orden de compra #' . $order->id);
            }
            
            // Definir nombre de archivo
            $fileName = 'order_' . $order->order_number . '_' . time() . '.pdf';
            
            // Guardar en storage público
            $path = 'purchase_orders/' . $fileName;
            Storage::disk('public')->put($path, $pdf->output());
            
            Log::info('PDF generado exitosamente para orden de compra #' . $order->id . ' en ruta: ' . $path);
            
            return $path;
        } catch (Exception $e) {
            Log::error('Error al generar PDF para orden de compra #' . $order->id . ': ' . $e->getMessage());
            throw $e;
        }
    }
    
    /**
     * Genera y devuelve directamente el objeto PDF (para pruebas y adjuntos)
     */
    public function createPdf(PurchaseOrder $order, $providerSelections = null)
    {
        try {
            // Cargar la solicitud y sus relaciones
            $order->load(['purchaseRequest.user', 'purchaseRequest.selectedQuotation', 'purchaseRequest.approver', 'provider']);
            
            // Preparar valores fiscales consistentes
            $taxValues = $this->prepareTaxValues($order);
            
            // Verificar si es un servicio sin cotización
            if ($order->purchaseRequest->isNoQuotationService()) {
                // Usar plantilla para servicios sin cotización
                $view = view('purchase-orders.pdf-template-service', array_merge([
                    'order' => $order,
                    'purchaseRequest' => $order->purchaseRequest,
                ], $taxValues));
            } else {
                // Verificar si tenemos selecciones específicas del proveedor (selección mixta)
                if ($providerSelections !== null) {
                    // Usar selecciones específicas del proveedor para selección mixta
                    $view = view('purchase-orders.pdf-template-mixed', array_merge([
                        'order' => $order,
                        'purchaseRequest' => $order->purchaseRequest,
                        'mixedSelections' => $providerSelections,
                    ], $taxValues));
                } else {
                    // Verificar si es una orden con selección mixta (caso legacy)
                    $hasMixedSelection = $order->purchaseRequest->quotationItemSelections()->exists();
                    
                    if ($hasMixedSelection) {
                        // Cargar selecciones específicas del proveedor
                        $mixedSelections = $this->getProviderSpecificSelections($order);
                        
                        // Usar plantilla para selección mixta
                        $view = view('purchase-orders.pdf-template-mixed', array_merge([
                            'order' => $order,
                            'purchaseRequest' => $order->purchaseRequest,
                            'mixedSelections' => $mixedSelections,
                        ], $taxValues));
                    } else {
                        // Obtener datos de la cotización seleccionada para orden tradicional
                        $quotation = $order->purchaseRequest->selectedQuotation;
                        
                        // Usar plantilla tradicional
                        $view = view('purchase-orders.pdf-template-new', array_merge([
                            'order' => $order,
                            'purchaseRequest' => $order->purchaseRequest,
                            'quotation' => $quotation,
                            'items' => $order->purchaseRequest->purchase_items ?? [],
                            'additionalItems' => $order->additional_items ?? [],
                            'tax_consumption' => 0,
                            'discount' => 0,
                        ], $taxValues));
                    }
                }
            }
            
            // Generar PDF
            $pdf = \PDF::loadHTML($view->render());
            $pdf->setPaper('letter', 'portrait');
            
            return $pdf;
        } catch (Exception $e) {
            Log::error('Error al crear PDF para orden de compra #' . $order->id . ': ' . $e->getMessage());
            throw $e;
        }
    }
    
    public function getPdfPath(PurchaseOrder $order): string
    {
        return $order->file_path;
    }
    
    /**
     * Genera PDF usando datos personalizados pero manteniendo el template original
     */
    private function generateCustomPdf(PurchaseOrder $order, $providerSelections = null)
    {
        try {
            $customData = json_decode($order->pdf_custom_data, true);
            
            // Crear un pseudo-proveedor con los datos personalizados
            $customProvider = (object) [
                'nombre' => $customData['provider_name'] ?? $order->provider->nombre ?? '',
                'nit' => $customData['provider_nit'] ?? $order->provider->nit ?? '',
                'email' => $customData['provider_email'] ?? $order->provider->email ?? '',
                'telefono' => $customData['provider_phone'] ?? $order->provider->telefono ?? '',
                'direccion' => $customData['provider_address'] ?? $order->provider->direccion ?? '',
            ];
            
            // Temporalmente reemplazar el proveedor con datos personalizados
            $originalProvider = $order->provider;
            $order->setRelation('provider', $customProvider);
            
            // Preparar valores fiscales consistentes usando datos personalizados
            $taxValues = $this->prepareTaxValues($order, $customData);
            
            // Actualizar la orden con los valores fiscales preparados
            $order->subtotal = $taxValues['subtotal'];
            $order->iva_amount = $taxValues['ivaAmount'];
            $order->tax_amount = $taxValues['ivaAmount'];
            $order->total_amount = $taxValues['totalAmount'];
            $order->includes_iva = $taxValues['includesIva'];
            
            // Usar la lógica original para determinar el template correcto
            $view = null;
            
            // Verificar si es un servicio sin cotización
            if ($order->purchaseRequest->isNoQuotationService()) {
                // Para servicios sin cotización, usar todos los items personalizados
                $itemsToUse = $customData['items'] ?? [];
                
                // Usar template de servicio con datos personalizados
                $view = view('purchase-orders.pdf-template-service', array_merge([
                    'order' => $order,
                    'purchaseRequest' => $order->purchaseRequest,
                    'customItems' => $itemsToUse,
                ], $taxValues));
            } else {
                // Verificar si es selección mixta para filtrar items
                $hasMixedSelection = $order->purchaseRequest->quotationItemSelections()->exists();
                $itemsToUse = $customData['items'] ?? [];
                
                if ($hasMixedSelection) {
                    // 🔥 Para selecciones mixtas, usar solo items del proveedor
                    // Si ya tenemos selecciones filtradas del controlador, usarlas; sino, obtenerlas
                    if ($providerSelections === null) {
                        $providerSelections = $this->getProviderSpecificSelections($order);
                    }
                    
                    // 🚨 CORRECCIÓN FINAL: Mapear items de customData con selecciones reales del proveedor
                    $itemsToUse = [];
                    $allCustomItems = $customData['items'] ?? [];
                    
                    foreach ($providerSelections as $selection) {
                        // Buscar el item correspondiente en customData por descripción
                        foreach ($allCustomItems as $customItem) {
                            if (trim($customItem['description']) === trim($selection->item_description)) {
                                $itemsToUse[] = $customItem;
                                break; // Solo agregar el primer match para evitar duplicados
                            }
                        }
                    }
                    
                    Log::info('🎯 FILTRADO EN PDF PERSONALIZADO - MAPEADO CORRECTO', [
                        'order' => $order->order_number,
                        'provider' => $order->provider->nombre,
                        'total_custom_items' => count($customData['items'] ?? []),
                        'provider_selections' => $providerSelections->count(),
                        'filtered_items_used' => count($itemsToUse),
                        'selected_descriptions' => $providerSelections->pluck('item_description')->toArray(),
                        'filtered_descriptions' => array_column($itemsToUse, 'description')
                    ]);
                }
                
                // Para órdenes normales, usar template tradicional
                $quotation = $order->purchaseRequest->selectedQuotation;
                
                Log::info('🚨 ITEMS FINALES PASADOS A PLANTILLA', [
                    'order' => $order->order_number,
                    'items_count' => count($itemsToUse),
                    'items_details' => array_map(function($item) {
                        return [
                            'description' => $item['description'] ?? 'N/A',
                            'quantity' => $item['quantity'] ?? 0
                        ];
                    }, $itemsToUse)
                ]);
                
                $view = view('purchase-orders.pdf-template-new', array_merge([
                    'order' => $order,
                    'purchaseRequest' => $order->purchaseRequest,
                    'quotation' => $quotation,
                    'items' => $itemsToUse, // Usar items filtrados en lugar de todos los items
                    'additionalItems' => $order->additional_items ?? [],
                    'tax_consumption' => 0,
                    'discount' => 0,
                ], $taxValues));
            }
            
            // Restaurar el proveedor original
            $order->setRelation('provider', $originalProvider);
            
            // Generar PDF
            $pdf = \PDF::loadHTML($view->render());
            $pdf->setPaper('letter', 'portrait');
            
            // Guardar el PDF
            $filename = 'order_' . $order->order_number . '_' . time() . '.pdf';
            $pdfPath = 'purchase_orders/' . $filename;
            
            Storage::disk('public')->put($pdfPath, $pdf->output());
            
            return $pdfPath;
            
        } catch (Exception $e) {
            Log::error('Error al generar PDF personalizado para orden #' . $order->id . ': ' . $e->getMessage());
            throw $e;
        }
    }
    
    /**
     * Obtener selecciones específicas del proveedor para órdenes de selección mixta
     */
    private function getProviderSpecificSelections(PurchaseOrder $order)
    {
        \Log::info('Getting provider specific selections', [
            'order_id' => $order->id,
            'provider_id' => $order->provider_id,
            'provider_name' => $order->provider->nombre ?? 'unknown'
        ]);

        $selections = $order->purchaseRequest->quotationItemSelections()
            ->with(['quotation'])
            ->whereHas('quotation', function($query) use ($order) {
                $query->where('provider_name', $order->provider->nombre);
            })
            ->get();

        \Log::info('Provider specific selections found', [
            'count' => $selections->count(),
            'provider_name' => $order->provider->nombre ?? 'unknown'
        ]);

        return $selections;
    }
}
